FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 matchlab
COPY requirements-preview.txt /app/
RUN pip install --no-cache-dir -r requirements-preview.txt
COPY --chown=matchlab:matchlab . /app/
USER matchlab
EXPOSE 8080
CMD ["python", "preview_service.py"]
